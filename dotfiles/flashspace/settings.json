{
  "activeWorkspaceOnFocusChange": true,
  "autoAssignAlreadyAssignedApps": false,
  "autoAssignAppsToWorkspaces": false,
  "centerCursorOnWorkspaceChange": false,
  "changeWorkspaceOnAppAssign": false,
  "checkForUpdatesAutomatically": true,
  "displayMode": "static",
  "enableFocusManagement": false,
  "enableIntegrations": true,
  "enablePictureInPictureSupport": false,
  "enableSpaceControl": false,
  "enableSwipeGestures": false,
  "enableWorkspaceSwitcher": true,
  "enableWorkspaceTransitions": false,
  "floatingApps": [],
  "keepUnassignedAppsOnSwitch": false,
  "loopWorkspaces": true,
  "loopWorkspacesOnAllDisplays": false,
  "menuBarBoldTitle": true,
  "menuBarIconSpacing": 4,
  "menuBarMinWidth": 20,
  "menuBarTitleTemplate": "$WORKSPACE",
  "restoreHiddenAppsOnSwitch": true,
  "runScriptAfterWorkspaceChange": "$HOME/.local/bin/flashspace-maximize \"$WORKSPACE\"; sketchybar --trigger flashspace_workspace_change WORKSPACE=\"$WORKSPACE\" >/dev/null 2>&1 || true",
  "runScriptOnLaunch": "$HOME/.local/bin/flashspace-maximize",
  "showFloatingNotifications": false,
  "showMenuBar": true,
  "showMenuBarIcon": true,
  "showMenuBarTitle": true,
  "showRecentWorkspaceWhenActivatedTwice": true,
  "showWorkspaceSwitcher": "opt+tab",
  "skipEmptyWorkspacesOnSwitch": false,
  "switchToNextWorkspace": "cmd+ctrl+opt+shift+right",
  "switchToPreviousWorkspace": "cmd+ctrl+opt+shift+left",
  "workspaceSwitcherCurrentDisplayWorkspaces": true,
  "workspaceSwitcherShowScreenshots": false,
  "workspaceSwitcherSortByLastActivation": false,
  "workspaceSwitcherVisibleWorkspaces": 8
}
