#!/bin/bash
set -euo pipefail

find_yazi_window() {
  aerospace list-windows --all --format '%{window-id}|%{window-title}' 2>/dev/null \
    | awk -F '|' '!found && $2 ~ /^Yazi:/ { print $1; found = 1 }'
}

WINDOW_ID=$(find_yazi_window)

if [ -n "$WINDOW_ID" ]; then
  aerospace focus --window-id "$WINDOW_ID"
  exit 0
fi

wezterm start -- yazi >/dev/null 2>&1 &

# Wait for AeroSpace to register the new window before focusing it.
for _ in {1..50}; do
  WINDOW_ID=$(find_yazi_window)
  if [ -n "$WINDOW_ID" ]; then
    aerospace focus --window-id "$WINDOW_ID"
    exit 0
  fi
  sleep 0.1
done

echo "Timed out waiting for the Yazi window" >&2
exit 1
