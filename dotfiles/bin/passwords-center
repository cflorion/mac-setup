#!/bin/bash
set -euo pipefail

# Apple Passwords — every window is resized to a fixed proportion of the
# active display (WIDTH_PCT x HEIGHT_PCT of its visible frame) and centered.
# The app has no persistent window-size setting and reopens small, so this
# reapplies the size on every appearance rather than only on first launch.
# Run automatically by AeroSpace's on-window-detected rule (aerospace.toml)
# each time a Passwords window appears — not bound to a hotkey.
#
# Passwords has no AppleScript dictionary (unlike Notes, see notes-scratch),
# so this goes through the accessibility API (System Events) instead of
# `set bounds of window`. The accessibility set is a silent no-op unless the
# app is frontmost, hence the `activate` before resizing.

WIDTH_PCT="${PASSWORDS_WIDTH_PCT:-75}"
HEIGHT_PCT="${PASSWORDS_HEIGHT_PCT:-85}"
BUNDLE_ID="com.apple.Passwords"

osascript -e "tell application id \"$BUNDLE_ID\" to activate" >/dev/null 2>&1 || true

# NSScreen's visibleFrame is bottom-left/y-up (AppKit); System Events'
# position/size is top-left/y-down. The y-flip is anchored on the primary
# screen's height, same trick as notes-scratch's resize_and_center.
origin_and_size=$(osascript -l JavaScript - "$WIDTH_PCT" "$HEIGHT_PCT" <<'JXA' 2>/dev/null
function run(argv) {
    ObjC.import('AppKit')
    var wPct = Number(argv[0]) / 100
    var hPct = Number(argv[1]) / 100
    var primaryHeight = $.NSScreen.screens.objectAtIndex(0).frame.size.height
    var vf = $.NSScreen.mainScreen.visibleFrame
    var w = Math.round(vf.size.width * wPct)
    var h = Math.round(vf.size.height * hPct)
    var x = Math.round(vf.origin.x + (vf.size.width - w) / 2)
    var appkitY = vf.origin.y + (vf.size.height - h) / 2
    var y = Math.round(primaryHeight - appkitY - h)
    return x + " " + y + " " + w + " " + h
}
JXA
) || exit 0

read -r x y w h <<<"$origin_and_size"

# Setting {position, size} together as one record is silently refused
# ("Accès non autorisé") even when the app is frontmost; two separate sets
# work fine.
for _ in $(seq 10); do
    osascript -e "tell application \"System Events\" to tell process \"Passwords\" to set position of window 1 to {$x, $y}" >/dev/null 2>&1 \
        && osascript -e "tell application \"System Events\" to tell process \"Passwords\" to set size of window 1 to {$w, $h}" >/dev/null 2>&1 \
        && break
    sleep 0.1
done
