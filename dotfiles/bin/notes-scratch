#!/bin/bash
set -euo pipefail

# Hyper+N: toggle Apple Notes, on the "Brouillon" scratch note, over whatever you
# are doing — one window, the main Notes window.
#
# Replaces Antinote: the scratch note is a real Apple Notes note, so it syncs to
# the iPhone through iCloud instead of living in a second, Mac-only data store.
#
# - Notes focused: park its windows on the off-bar "Notes" workspace. AeroSpace
#   hands focus back to the window you were on, and puts the Notes window back
#   where it was when it returns.
# - Otherwise: bring every Notes window to the focused workspace, select the note
#   (created on first run) and front Notes, launching it if needed.
#
# Parking rather than ⌘H: AeroSpace (0.21) turns the window of a macOS-hidden app
# into a tiling window when it moves to another workspace, reshuffling that
# workspace until the app is unhidden. A manual ⌘H is still handled: Notes is
# unhidden first — without being fronted — and its windows move once AeroSpace
# sees them floating again.
#
# Windows move *before* Notes is fronted: fronting an app whose window sits on
# another workspace makes AeroSpace switch to that workspace.
#
# Apple Notes derives a note's name from its first line — keep "Brouillon" on
# line 1 and type below it, or the next Hyper+N creates a fresh note.

NOTE_NAME="${NOTES_SCRATCH_NOTE:-Brouillon}"
BUNDLE_ID="com.apple.Notes"
# Deliberately not in sketchybar's spaces.lua (like OBS in aerospace.toml): out of
# the bar and out of the workspace cycle.
PARKING_WORKSPACE="Notes"

# Serialize. Hyper+N binds this via `exec-and-forget`, which does not wait, so a
# quick double press runs two copies at once — and the first one could front
# Notes after the second one parked it, pulling you onto the parking workspace.
# A press that lands while another copy is running is dropped.
LOCK="${TMPDIR:-/tmp}/notes-scratch.lock"
if command -v shlock >/dev/null 2>&1; then
    shlock -f "$LOCK" -p "$$" || exit 0
    trap '/bin/rm -f "$LOCK"' EXIT
fi

notes_windows() {
    aerospace list-windows --monitor all --app-bundle-id "$BUNDLE_ID" \
        --format '%{window-id} %{workspace} %{window-layout}' 2>/dev/null || true
}

notes_hidden() {
    notes_windows | grep -q ' macos_native_window_of_hidden_app$'
}

# Move every Notes window to a workspace, skipping those already on it.
move_notes_to() {
    notes_windows | while read -r wid wws _; do
        if [ -n "$wid" ] && [ "$wws" != "$1" ]; then
            aerospace move-node-to-workspace --window-id "$wid" "$1" 2>/dev/null || true
        fi
    done
}

# Create the note on first run, then select it in the notes list.
select_note() {
    osascript - "$NOTE_NAME" <<'APPLESCRIPT'
on run argv
    set noteName to item 1 of argv
    tell application "Notes"
        if not (exists note noteName) then
            -- Apple Notes takes the title from the first line of the body,
            -- so the body has to start with the name we want to match on.
            make new note with properties ¬
                {body:"<div><b>" & noteName & "</b></div><div><br></div>"}
        end if
        show note noteName
    end tell
end run
APPLESCRIPT
}

ws=$(aerospace list-workspaces --focused)

if [ "$(aerospace list-windows --focused --format '%{app-bundle-id}' 2>/dev/null)" = "$BUNDLE_ID" ]; then
    move_notes_to "$PARKING_WORKSPACE"
    # Notes was reached on its parking workspace (⌘Tab): go back where you were.
    if [ "$ws" = "$PARKING_WORKSPACE" ]; then
        aerospace workspace-back-and-forth 2>/dev/null || true
    fi
    exit 0
fi

if notes_hidden; then
    # NSRunningApplication needs no Automation permission, and unhide does not
    # front the app. AeroSpace sees the windows floating again within ~0.2s.
    osascript -l JavaScript -e "ObjC.import('AppKit'); \$.NSRunningApplication.runningApplicationsWithBundleIdentifier('$BUNDLE_ID').firstObject.unhide" >/dev/null
    for _ in $(seq 20); do
        notes_hidden || break
        sleep 0.05
    done
fi

move_notes_to "$ws"
# Still front Notes when the note can't be selected (e.g. Automation denied).
select_note >/dev/null || echo "notes-scratch: could not select note '$NOTE_NAME'" >&2
open -b "$BUNDLE_ID"
