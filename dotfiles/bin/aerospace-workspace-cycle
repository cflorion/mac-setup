#!/usr/bin/env bash
set -euo pipefail

# Serialize. Hyper+up/down bind this via `exec-and-forget`, which does not wait,
# so spamming the key fast spawns several copies at once. Concurrent copies all
# read the same stale focus and issue redundant/backward `aerospace workspace`
# calls; AeroSpace then fires its workspace-change hooks out of order and the
# SketchyBar highlight jumps around (the flicker). A single-holder lock makes
# each press read the freshly-committed focus and advance exactly one step. A
# press that lands while another copy is in flight is simply dropped — at machine
# speed you cannot perceive the dropped step, but you would perceive the flicker.
# Guard on shlock being present: if it ever isn't on PATH, degrade to running
# without serialization (may flicker) rather than `|| exit 0`-ing every press
# into a silent no-op, which would kill navigation entirely.
LOCK="${TMPDIR:-/tmp}/aerospace-workspace-cycle.lock"
if command -v shlock >/dev/null 2>&1; then
    shlock -f "$LOCK" -p "$$" || exit 0
    trap '/bin/rm -f "$LOCK"' EXIT
fi

DIRECTION="${1:-next}"

# Cycle order = SketchyBar display order. Derive it straight from spaces.lua
# (the single source of truth for workspace definitions) so the cycle can never
# drift from the bar when workspaces are added, removed, or reordered.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SPACES_LUA="$SCRIPT_DIR/../sketchybar/items/spaces.lua"

WORKSPACE_ORDER=()
while IFS= read -r ws; do
    WORKSPACE_ORDER+=("$ws")
done < <(grep -oE 'key = "[^"]+"' "$SPACES_LUA" | sed -E 's/.*"([^"]+)".*/\1/')

[[ ${#WORKSPACE_ORDER[@]} -eq 0 ]] && exit 0

CURRENT=$(aerospace list-workspaces --focused | tr -d '[:space:]')

ALL_OCCUPIED=$(aerospace list-workspaces --monitor all --empty no 2>/dev/null)

ORDERED=()
for ws in "${WORKSPACE_ORDER[@]}"; do
    if [[ "$ws" == "$CURRENT" ]] || [[ $'\n'"$ALL_OCCUPIED"$'\n' == *$'\n'"$ws"$'\n'* ]]; then
        ORDERED+=("$ws")
    fi
done

COUNT=${#ORDERED[@]}
[[ $COUNT -eq 0 ]] && exit 0

CURRENT_IDX=0
for i in "${!ORDERED[@]}"; do
    [[ "${ORDERED[$i]}" == "$CURRENT" ]] && CURRENT_IDX=$i
done

if [[ "$DIRECTION" == "next" ]]; then
    TARGET=${ORDERED[$(( (CURRENT_IDX + 1) % COUNT ))]}
else
    TARGET=${ORDERED[$(( (CURRENT_IDX - 1 + COUNT) % COUNT ))]}
fi

# NB: do not pre-trigger sketchybar with TARGET here. AeroSpace's
# exec-on-workspace-change hook fires the highlight after the switch actually
# commits, in real commit order. A predicted pre-highlight races ahead of those
# events and, on rapid navigation, a late hook for an earlier switch yanks the
# highlight backward (next → previous → next flicker). Let the hook drive it.
aerospace workspace "$TARGET"
