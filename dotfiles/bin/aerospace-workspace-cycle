#!/usr/bin/env bash
set -euo pipefail

DIRECTION="${1:-next}"
WORKSPACE_ORDER=(C W S M N G V P O T I Y X B E 1 2 3)

CURRENT=$(aerospace list-workspaces --focused | tr -d '[:space:]')

# Two calls instead of 17: covers both regular workspaces and Chrome PWAs
ALL_OCCUPIED=$(
    aerospace list-workspaces --monitor all --empty no 2>/dev/null
    aerospace list-windows --all --format '%{workspace}' 2>/dev/null
)

ORDERED=()
for ws in "${WORKSPACE_ORDER[@]}"; do
    if [[ "$ws" == "$CURRENT" ]] || echo "$ALL_OCCUPIED" | grep -qx "$ws"; then
        ORDERED+=("$ws")
    fi
done

COUNT=${#ORDERED[@]}
[[ $COUNT -eq 0 ]] && exit 0

CURRENT_IDX=0
for i in "${!ORDERED[@]}"; do
    [[ "${ORDERED[$i]}" == "$CURRENT" ]] && CURRENT_IDX=$i
done

if [[ "$DIRECTION" == "next" ]]; then
    TARGET=${ORDERED[$(( (CURRENT_IDX + 1) % COUNT ))]}
else
    TARGET=${ORDERED[$(( (CURRENT_IDX - 1 + COUNT) % COUNT ))]}
fi

# Pre-highlight the target in SketchyBar before the actual switch (~400ms)
# spaces.lua reads FOCUSED_WORKSPACE from the event env to skip its own AeroSpace query
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$TARGET" PREV_WORKSPACE="$CURRENT"

aerospace workspace "$TARGET"
