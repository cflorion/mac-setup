#!/usr/bin/env bash
set -euo pipefail

# Enhanced PR helper: push, create/view PR with AI-generated description, print URL, open browser

# Colors for output formatting
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

BASE_BRANCH="main"
MODEL_ID="opencode/claude-haiku-4-5"
DIFF_CHAR_LIMIT=25000

usage() {
	cat <<EOF
Usage: pr [-b base_branch] [-m model_id] [-f] [-h]

Options:
  -b  Base branch to compare against (default: main)
  -m  Model ID for AI generation (default: ${MODEL_ID})
  -f  Force regenerate description even if PR exists
  -h  Show this help

Flow:
  1) Push branch to origin
  2) Prompt for description style (short/thorough)
  3) Generate AI description
  4) Open \$EDITOR to review/edit (use :cq to abort)
  5) Create PR and open in browser
EOF
}

# Prompt for description style
prompt_style() {
	echo -e "${BLUE}PR description style:${NC}" >&2
	echo "  1) Short (default)" >&2
	echo "  2) Thorough" >&2
	printf "Choice [1]: " >&2
	read -r choice
	case "$choice" in
	2) echo "thorough" ;;
	*) echo "short" ;;
	esac
}

# Edit PR content in $EDITOR. Returns 1 if user aborts with :cq
edit_pr_content() {
	local title="$1"
	local body="$2"

	local tmpfile
	tmpfile=$(mktemp "${TMPDIR:-/tmp}/pr-XXXXXX.md")
	trap "rm -f '$tmpfile'" EXIT

	# Write content: title on line 1, blank line, body
	{
		echo "$title"
		echo ""
		echo "$body"
	} >"$tmpfile"

	# Open editor
	${EDITOR:-nvim} "$tmpfile"
	local editor_exit=$?

	# Check for abort (:cq exits with 1 in vim/nvim)
	if [[ $editor_exit -ne 0 ]]; then
		echo -e "${YELLOW}Aborted by user${NC}" >&2
		return 1
	fi

	# Parse edited content
	PR_TITLE=$(head -n1 "$tmpfile" | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//')
	PR_BODY=$(tail -n +3 "$tmpfile")

	if [[ -z "$PR_TITLE" ]]; then
		echo -e "${RED}Error: title cannot be empty${NC}" >&2
		return 1
	fi

	return 0
}

FORCE_UPDATE=false
while getopts ":b:m:fh" opt; do
	case $opt in
	b) BASE_BRANCH="$OPTARG" ;;
	m) MODEL_ID="$OPTARG" ;;
	f) FORCE_UPDATE=true ;;
	h)
		usage
		exit 0
		;;
	:)
		echo -e "${RED}Option -$OPTARG requires an argument.${NC}"
		usage
		exit 1
		;;
	\?)
		echo -e "${RED}Invalid option -$OPTARG${NC}"
		usage
		exit 1
		;;
	esac
done

open_url() {
	local url="$1"
	# Try native openers first (quietly)
	if command -v open >/dev/null 2>&1; then
		(nohup open "$url" >/dev/null 2>&1 &)
		return 0
	fi
	if command -v xdg-open >/dev/null 2>&1; then
		(nohup xdg-open "$url" >/dev/null 2>&1 &)
		return 0
	fi
	# Fallback: ask gh to open in web (suppressed)
	gh pr view "$url" --web >/dev/null 2>&1 || true
}

generate_pr_title() {
	local branch_name="$1"
	local commit_history="$2"

	local title_prompt="Generate a PR title from branch and commits.

Branch: $branch_name
Commits: $commit_history

Rules: max 50 chars, imperative mood (Add/Fix/Update/Remove), specific not vague.
Output only the title:"

	echo "$title_prompt" | timeout 30s opencode run -m "$MODEL_ID" - 2>/dev/null | head -n1 | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//'
}

generate_short_description() {
	local diff="$1"
	local commit_history="$2"

	local prompt="Write a 2-3 sentence PR description. State what changed and why.

Commits: $commit_history

Be specific and concise. No sections or headers. Output only the description:"

	echo "$diff" | timeout 45s opencode run -m "$MODEL_ID" "$prompt" 2>/dev/null | grep -v "opencode" || echo "Failed to generate description"
}

generate_thorough_description() {
	local diff="$1"
	local commit_history="$2"
	local files_changed="$3"
	local has_ui_files="$4"

	local screenshots_section=""
	if [[ "$has_ui_files" == "true" ]]; then
		screenshots_section="
## Screenshots
[Add screenshots of UI changes]"
	fi

	local prompt="Generate a PR description for code reviewers.

Commits: $commit_history
Files: $files_changed

Use this template:

## Summary
[2-3 sentences: what changed]

## Motivation
[Why this change was needed]

## Implementation
[Key decisions, approach, tradeoffs]

## Verification
[How to test/verify these changes]
$screenshots_section
## Notes
[Risks, follow-ups, areas needing scrutiny - omit section if nothing notable]

Rules: concise, specific, focus on reviewer needs. Omit empty sections."

	echo "$diff" | timeout 60s opencode run -m "$MODEL_ID" "$prompt" 2>/dev/null | grep -v "opencode" || echo "Failed to generate description"
}

# Get diff data for description generation
get_diff_data() {
	local base_ref="$1"

	git fetch origin "$BASE_BRANCH" --quiet >/dev/null 2>&1 || true

	local resolved_base="$base_ref"
	if ! git rev-parse --verify --quiet "$base_ref" >/dev/null; then
		if git rev-parse --verify --quiet "origin/$base_ref" >/dev/null; then
			resolved_base="origin/$base_ref"
		fi
	fi

	local base_point
	if ! base_point=$(git merge-base "$resolved_base" HEAD 2>/dev/null); then
		base_point="$resolved_base"
	fi

	local lock_globs=(
		'*.lock' 'yarn.lock' 'package-lock.json' 'pnpm-lock.yaml'
		'bun.lockb' 'Cargo.lock' 'Gemfile.lock' 'Podfile.lock' 'composer.lock' 'go.sum'
	)

	local exclude_args=()
	for g in "${lock_globs[@]}"; do
		exclude_args+=(":(exclude)$g")
	done

	DIFF_COMMIT_HISTORY=$(git log --pretty=format:'%s' "$base_point..HEAD" 2>/dev/null || echo "")
	DIFF_FILES_CHANGED=$(git diff --name-status "$base_point" "${exclude_args[@]}" 2>/dev/null || echo "")
	DIFF_FULL=$(git diff "$base_point" "${exclude_args[@]}" 2>/dev/null || echo "")

	if [ ${#DIFF_FULL} -gt $DIFF_CHAR_LIMIT ]; then
		DIFF_FULL=${DIFF_FULL:0:$DIFF_CHAR_LIMIT}
	fi

	# Check for UI files
	DIFF_HAS_UI="false"
	if echo "$DIFF_FILES_CHANGED" | grep -qE '\.(tsx|jsx|css|scss|vue|svelte)$'; then
		DIFF_HAS_UI="true"
	fi

	if [ -z "$DIFF_FULL" ]; then
		return 1
	fi
}

# Get current branch
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [[ -z "$branch" ]]; then
	echo -e "${RED}Error: not a git repository${NC}" >&2
	exit 1
fi

if [[ "$branch" == "main" ]] || [[ "$branch" == "master" ]]; then
	echo -e "${RED}Error: cannot create PR from main/master${NC}" >&2
	exit 1
fi

# Check if opencode is available
if ! command -v opencode >/dev/null 2>&1; then
	echo -e "${YELLOW}Warning: opencode not found, using basic PR${NC}" >&2
	USE_AI=false
else
	USE_AI=true
fi

# Push branch
printf "↑ Pushing %s...\n" "$branch"
if ! git push -u origin "$branch" --quiet >/dev/null 2>&1; then
	echo -e "${RED}Error: push failed${NC}" >&2
	exit 1
fi
printf "✓ Pushed\n"

# Check if PR exists
url=""
pr_exists=false
url=$(gh pr view "$branch" --json url --jq .url 2>/dev/null) || true
if [[ -n "$url" ]]; then
	pr_exists=true
	if [[ "$FORCE_UPDATE" == "false" ]]; then
		printf "↺ PR exists\n"
		echo "$url"
		open_url "$url"
		exit 0
	fi
	printf "↺ PR exists, regenerating...\n"
fi

# Generate PR content
PR_TITLE="$branch"
PR_BODY=""

if [[ "$USE_AI" == "true" ]]; then
	# Get diff data
	printf "Fetching diff..."
	if ! get_diff_data "$BASE_BRANCH"; then
		printf "\n"
		echo -e "${YELLOW}Warning: no changes detected${NC}" >&2
	else
		printf " done\n"
	fi

	# Prompt for style
	style=$(prompt_style)
	echo -e "${BLUE}Generating ${style} description...${NC}"

	# Generate title
	if PR_TITLE=$(generate_pr_title "$branch" "$DIFF_COMMIT_HISTORY"); then
		if [[ -z "$PR_TITLE" ]] || [[ "$PR_TITLE" == *"Failed"* ]]; then
			PR_TITLE="$branch"
		fi
	else
		PR_TITLE="$branch"
	fi

	# Generate description based on style
	if [[ "$style" == "thorough" ]]; then
		PR_BODY=$(generate_thorough_description "$DIFF_FULL" "$DIFF_COMMIT_HISTORY" "$DIFF_FILES_CHANGED" "$DIFF_HAS_UI")
	else
		PR_BODY=$(generate_short_description "$DIFF_FULL" "$DIFF_COMMIT_HISTORY")
	fi

	echo -e "${GREEN}✓ Generated${NC}"

	# Open editor for review
	echo -e "${BLUE}Opening editor for review...${NC}"
	if ! edit_pr_content "$PR_TITLE" "$PR_BODY"; then
		exit 1
	fi
fi

# Create or update PR
if [[ "$pr_exists" == "true" ]]; then
	if [[ -n "$PR_BODY" ]]; then
		if gh pr edit "$branch" --title "$PR_TITLE" --body "$PR_BODY" >/dev/null 2>&1; then
			printf "✓ Updated PR\n"
		else
			echo -e "${YELLOW}Warning: failed to update PR${NC}" >&2
		fi
	fi
else
	if [[ -n "$PR_BODY" ]]; then
		if gh pr create --title "$PR_TITLE" --body "$PR_BODY" --draft >/dev/null 2>&1; then
			printf "✓ PR created\n"
		else
			if gh pr create -f -d >/dev/null 2>&1; then
				printf "✓ PR created (basic)\n"
			else
				echo -e "${RED}Error: failed to create PR${NC}" >&2
				exit 1
			fi
		fi
	else
		if gh pr create --title "$PR_TITLE" --draft >/dev/null 2>&1; then
			printf "✓ PR created\n"
		else
			if gh pr create -f -d >/dev/null 2>&1; then
				printf "✓ PR created (basic)\n"
			else
				echo -e "${RED}Error: failed to create PR${NC}" >&2
				exit 1
			fi
		fi
	fi
fi

# Get final URL and open
if url=$(timeout 10s gh pr view "$branch" --json url --jq .url 2>/dev/null); then
	if [[ -n "$url" ]]; then
		echo "$url"
		open_url "$url"
		exit 0
	fi
fi

echo -e "${RED}Error: PR created but URL unknown${NC}" >&2
exit 1
