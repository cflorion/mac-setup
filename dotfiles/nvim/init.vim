set number
set relativenumber
set mouse=a

set tabstop=2
set shiftwidth=2
set expandtab
set smartindent
set termguicolors

set ignorecase
set smartcase
set incsearch
set hlsearch

syntax on

colorscheme habamax
highlight Normal       guibg=#000000 guifg=#888888
highlight NonText      guibg=#000000 guifg=#444444
highlight SignColumn   guibg=#000000
highlight EndOfBuffer  guibg=#000000 guifg=#444444
