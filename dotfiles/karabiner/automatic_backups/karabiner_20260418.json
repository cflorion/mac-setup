                  {
                    "key_code": "left_shift",
                    "modifiers": ["left_command", "left_control", "left_option"]
                  }
                ],
                "to_if_alone": [
                  { "key_code": "escape" }
                ],
                "type": "basic"
              }
            ]
          }
        ]
      },
      "devices": [],
