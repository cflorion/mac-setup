<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.user.wezterm-mux-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-c</string>
		<string>rm -f "$HOME/Library/Application Support/com.github.wez.wezterm"/sock* && exec /opt/homebrew/bin/wezterm cli list 2>/dev/null || true</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/wezterm-mux-server.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/wezterm-mux-server.log</string>
</dict>
</plist>
