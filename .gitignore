.DS_Store
cache/
backup/

# Raycast rewrites its installed extensions into this dir via the
# ~/.config/raycast symlink. They are not config — only the *.rayconfig
# export is meaningful — so keep them out of git.
dotfiles/raycast/extensions/

# Karabiner-Elements auto-generates these on every config change.
dotfiles/karabiner/automatic_backups/

# ~/.local/bin is a symlink to dotfiles/bin, so Claude Code's native installer
# writes its launcher here: a symlink to ~/.local/share/claude/versions/<ver>
# that it rewrites on every auto-update. The installer owns it, not the repo.
dotfiles/bin/claude

# Ditherbuster (~/code/ditherbuster) installs its CLI and the dbust alias the
# same way: symlinks owned by that repository's make install.
dotfiles/bin/ditherbuster
dotfiles/bin/dbust
