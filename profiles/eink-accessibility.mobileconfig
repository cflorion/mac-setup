        <string>E1NK-ACC0-4D1S-PLAY-SETUP000002</string>
        <key>PayloadVersion</key>
        <integer>1</integer>
        <key>increaseContrast</key>
        <true/>
        <key>reduceTransparency</key>
        <true/>
        <key>reduceMotion</key>
        <true/>
