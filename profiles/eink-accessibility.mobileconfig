    <key>PayloadDisplayName</key>
    <string>E-Ink Display Accessibility</string>
    <key>PayloadDescription</key>
    <string>Accessibility settings optimized for a 13-inch color e-ink display: increase contrast, reduce transparency, differentiate without color, display contrast, and pointer size.</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadEnabled</key>
    <true/>
    <key>PayloadRemovalDisallowed</key>
    <false/>
