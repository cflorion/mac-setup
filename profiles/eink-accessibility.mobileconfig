    <array>
      <dict>
        <key>PayloadDisplayName</key>
        <string>E-Ink Accessibility Settings</string>
        <key>PayloadIdentifier</key>
        <string>com.mac-setup.eink-accessibility.universalaccess</string>
        <key>PayloadOrganization</key>
        <string>mac-setup</string>
        <key>PayloadType</key>
        <string>com.apple.universalaccess</string>
